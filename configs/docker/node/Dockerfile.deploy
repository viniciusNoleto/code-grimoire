# Debian (glibc) no build: os binários nativos (oxide do Tailwind, lightningcss…) vêm do mesmo lockfile do host.
FROM node:24-slim AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci --ignore-scripts

COPY . .
RUN npm run build

FROM node:24-slim

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

# servidor Nitro (páginas pré-renderizadas + rotas do Nuxt Content); as dependências já vêm empacotadas no .output
COPY --from=builder --chown=node:node /app/.output ./.output
RUN chown node:node /app

USER node

EXPOSE 3000

CMD ["node", ".output/server/index.mjs"]
